# 텍스트는 저장소 안에서 LF로 정규화하고, 체크아웃할 때 CRLF로 바꾼다
* text=auto eol=crlf

# 배치 파일 CRLF로 LF면 레이블·goto가 오동작할 수 있다
*.bat text eol=crlf

# 셸 스크립트와 Git 훅은 LF여야 실행된다 (CRLF면 "bad interpreter")
*.sh        text eol=lf
.githooks/* text eol=lf

# 언리얼 바이너리: Git LFS로 저장 (-text = 줄바꿈 변환 안 함)
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text